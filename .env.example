# Vorlage für .env — diese Datei liegt im Repository, .env NICHT (.gitignore).
#
# Verwendung:  cp .env.example .env   und die Werte eintragen.
#
# In params.yaml stehen Zahlen und Schwellen: Sie gehören zum Projekt und
# sollen versioniert sein. Hier stehen Zugangsdaten und umgebungsabhängige
# Einstellungen: Sie gehören zu *einem Rechner* und niemals ins Git.

# Ablageort der MLflow-Laufdaten. Leer lassen für die Voreinstellung
# (sqlite:///mlflow.db in der Projektwurzel). In der CI und auf
# Netzlaufwerken, auf denen SQLite nicht sperren kann, hier umstellen.
MLFLOW_TRACKING_URI=

# Protokollierstufe der Schnittstelle: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# Abweichende Konfigurationsdatei (Probelauf, CI). Leer lassen für params.yaml
# in der Projektwurzel.
MLOPS_PARAMS=
